# Database Configuration
DATABASE_PATH=database/screening_system.db

# Model Configuration
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2
SPACY_MODEL=en_core_web_sm

# Upload and Document Processing
MAX_FILE_SIZE_MB=10
ALLOWED_EXTENSIONS=pdf,docx,txt,doc

# Scoring Weights (Must sum to 1.0)
WEIGHT_SEMANTIC_SKILL_MATCH=0.35
WEIGHT_SKILL_EVIDENCE=0.25
WEIGHT_EXPERIENCE_RELEVANCE=0.20
WEIGHT_EDUCATION_RELEVANCE=0.10
WEIGHT_PROJECTS_CERTS=0.10

# Bias Reduction and Anonymization
ANONYMIZATION_PREFIX=ANON
ENABLE_PII_MASKING=true

# Logging
LOG_LEVEL=INFO
